<Window x:Class="CodexTpsFloat.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="Codex TPS 悬浮窗" Width="432" SizeToContent="Height" WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="True" Background="Transparent" ShowInTaskbar="True" Topmost="True" FontFamily="Microsoft YaHei UI" FontSize="12" Foreground="#262629">
 <Window.Resources>
  <Style TargetType="Button"><Setter Property="Cursor" Value="Hand"/><Setter Property="Foreground" Value="#75757D"/><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="8,5"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#F0F0F3"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  <Style x:Key="Segment" TargetType="RadioButton"><Setter Property="GroupName" Value="Window"/><Setter Property="Cursor" Value="Hand"/><Setter Property="FontSize" Value="13"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RadioButton"><Border x:Name="Box" Background="Transparent" CornerRadius="6" Padding="0,8"><ContentPresenter HorizontalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsChecked" Value="True"><Setter TargetName="Box" Property="Background" Value="#007AFF"/><Setter Property="Foreground" Value="White"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  <Style x:Key="Muted" TargetType="TextBlock"><Setter Property="Foreground" Value="#85858D"/><Setter Property="FontSize" Value="11"/></Style>
  <Style TargetType="ComboBox"><Setter Property="Height" Value="26"/><Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBox"><Grid><ToggleButton Focusable="False" IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"><ToggleButton.Template><ControlTemplate TargetType="ToggleButton"><Border Background="#F1F1F4" CornerRadius="5"><TextBlock Text="⌄" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,7,2" Foreground="#75757D"/></Border></ControlTemplate></ToggleButton.Template></ToggleButton><ContentPresenter Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" Margin="8,0,24,0" VerticalAlignment="Center" IsHitTestVisible="False"/><Popup IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" AllowsTransparency="True" Focusable="False"><Border Background="White" BorderBrush="#DEDEE4" BorderThickness="1" CornerRadius="5" Padding="4" MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"><ScrollViewer MaxHeight="260"><ItemsPresenter/></ScrollViewer></Border></Popup></Grid></ControlTemplate></Setter.Value></Setter></Style>
  <Style x:Key="Switch" TargetType="CheckBox"><Setter Property="Cursor" Value="Hand"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="CheckBox"><StackPanel Orientation="Horizontal"><ContentPresenter VerticalAlignment="Center" Margin="0,0,7,0"/><Border x:Name="Track" Width="30" Height="17" CornerRadius="9" Background="#E1E1E5"><Ellipse x:Name="Thumb" Fill="White" Width="13" Height="13" HorizontalAlignment="Left" Margin="2"/></Border></StackPanel><ControlTemplate.Triggers><Trigger Property="IsChecked" Value="True"><Setter TargetName="Track" Property="Background" Value="#007AFF"/><Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
 </Window.Resources>
 <Border Margin="16" CornerRadius="18" Background="White" BorderBrush="#DFDFE4" BorderThickness="1">
  <Border.Effect><DropShadowEffect BlurRadius="22" ShadowDepth="5" Opacity="0.2"/></Border.Effect>
  <StackPanel>
   <Grid Margin="16,13,12,12" MouseLeftButtonDown="DragHeader">
    <Grid.ColumnDefinitions><ColumnDefinition Width="36"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <Border Width="30" Height="30" CornerRadius="8" Background="#F3F5F8" VerticalAlignment="Center"><TextBlock Text="&lt;/&gt;" FontFamily="Consolas" FontWeight="Bold" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#007AFF"/></Border>
    <StackPanel Grid.Column="1" Margin="8,0,0,0"><TextBlock Text="Codex TPS" FontWeight="SemiBold" FontSize="15"/><StackPanel Orientation="Horizontal" Margin="0,3,0,0"><Ellipse x:Name="StatusDot" Width="6" Height="6" Fill="#34C759" Margin="0,0,6,0"/><TextBlock x:Name="StatusText" Text="读取中" Style="{StaticResource Muted}"/></StackPanel></StackPanel>
    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center"><Button x:Name="RefreshButton" Content="↻" FontSize="20" Click="RefreshClick" ToolTip="立即刷新" AutomationProperties.Name="立即刷新"/><Button Content="▱" FontSize="20" Click="FolderClick" ToolTip="打开会话目录" AutomationProperties.Name="打开会话目录"/><Button x:Name="PinButton" Content="◆" Click="PinClick" ToolTip="切换置顶" AutomationProperties.Name="切换置顶" Foreground="#007AFF"/><Button Content="−" Click="HideClick" ToolTip="收起到托盘" AutomationProperties.Name="收起到托盘"/></StackPanel>
   </Grid>
   <Border Height="1" Background="#E7E7EB"/>
   <StackPanel Margin="18,16,18,14">
    <Border Background="#EEEEF1" CornerRadius="7"><UniformGrid Columns="4"><RadioButton Style="{StaticResource Segment}" Content="1 分钟" Tag="60" Checked="WindowChanged"/><RadioButton Style="{StaticResource Segment}" Content="5 分钟" Tag="300" IsChecked="True" Checked="WindowChanged"/><RadioButton Style="{StaticResource Segment}" Content="30 分钟" Tag="1800" Checked="WindowChanged"/><RadioButton Style="{StaticResource Segment}" Content="1 小时" Tag="3600" Checked="WindowChanged"/></UniformGrid></Border>
    <Grid Margin="0,13,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="输出生成速度 · 估算" Style="{StaticResource Muted}" ToolTip="本窗口内完成响应的输出词元总数 ÷ 流式阶段耗时总和。包含推理词元；基于输出项计时，非精确逐词元解码速度。"/><ComboBox x:Name="ModelBox" Grid.Column="1" Width="140" Height="23" FontSize="10" SelectionChanged="ModelChanged" ToolTip="按模型筛选"/></Grid>
    <Grid Margin="0,5,0,13"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Orientation="Horizontal" VerticalAlignment="Bottom"><TextBlock x:Name="HeroValue" Text="—" FontFamily="Segoe UI" FontSize="38" FontWeight="SemiBold"/><TextBlock Text="词元/秒" Style="{StaticResource Muted}" VerticalAlignment="Bottom" Margin="7,0,0,8"/></StackPanel><StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock x:Name="RequestValue" Text="0.0" HorizontalAlignment="Right" FontSize="17" FontWeight="SemiBold"/><TextBlock Text="请求/分钟" Style="{StaticResource Muted}" Margin="0,3,0,0"/></StackPanel></Grid>
    <UniformGrid Columns="4">
     <StackPanel><StackPanel Orientation="Horizontal"><Ellipse Fill="#007AFF" Width="6" Height="6" Margin="0,0,5,0"/><TextBlock Text="输入" Style="{StaticResource Muted}"/></StackPanel><TextBlock x:Name="InputValue" Text="0" FontFamily="Segoe UI" FontWeight="SemiBold" FontSize="16" Margin="0,5,0,2"/><TextBlock Text="词元/秒" Style="{StaticResource Muted}"/></StackPanel>
     <StackPanel><StackPanel Orientation="Horizontal"><Ellipse Fill="#00BCCF" Width="6" Height="6" Margin="0,0,5,0"/><TextBlock Text="缓存" Style="{StaticResource Muted}"/></StackPanel><TextBlock x:Name="CachedValue" Text="0" FontFamily="Segoe UI" FontWeight="SemiBold" FontSize="16" Margin="0,5,0,2"/><TextBlock Text="词元/秒" Style="{StaticResource Muted}"/></StackPanel>
     <StackPanel><StackPanel Orientation="Horizontal"><Ellipse Fill="#FF9500" Width="6" Height="6" Margin="0,0,5,0"/><TextBlock Text="输出" Style="{StaticResource Muted}"/></StackPanel><TextBlock x:Name="OutputValue" Text="0" FontFamily="Segoe UI" FontWeight="SemiBold" FontSize="16" Margin="0,5,0,2"/><TextBlock Text="词元/秒" Style="{StaticResource Muted}"/></StackPanel>
     <StackPanel><StackPanel Orientation="Horizontal"><Ellipse Fill="#BF40D1" Width="6" Height="6" Margin="0,0,5,0"/><TextBlock Text="推理" Style="{StaticResource Muted}"/></StackPanel><TextBlock x:Name="ReasoningValue" Text="0" FontFamily="Segoe UI" FontWeight="SemiBold" FontSize="16" Margin="0,5,0,2"/><TextBlock Text="词元/秒" Style="{StaticResource Muted}"/></StackPanel>
    </UniformGrid>
    <TextBlock Text="上方四色数值为窗口完成量 ÷ 窗口秒数" FontSize="10" Foreground="#A4A4AB" Margin="0,9,0,0"/>
    <Grid Margin="0,11,0,0"><TextBlock x:Name="SessionsValue" Text="0 个活跃会话" Style="{StaticResource Muted}"/><TextBlock x:Name="CacheRatioValue" Text="缓存占比 0%" Style="{StaticResource Muted}" HorizontalAlignment="Right"/></Grid>
    <Grid Margin="0,8,0,0"><TextBlock x:Name="SamplesValue" Text="计时样本 0" Style="{StaticResource Muted}"/><TextBlock x:Name="TtftValue" Text="轮次首字 —" Style="{StaticResource Muted}" HorizontalAlignment="Right" ToolTip="已结束轮次的日志 time_to_first_token_ms 中位数，不是每次内部模型请求的 TTFT。"/></Grid>
   </StackPanel>
   <Border Height="1" Background="#E7E7EB"/>
   <Grid Margin="10,4"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Button x:Name="HistoryButton" Content="今日分时  ›" Click="HistoryClick" HorizontalAlignment="Left" Foreground="#55555D"/><Button Grid.Column="1" Content="设置" Click="SettingsClick"/></Grid>
   <StackPanel x:Name="HistoryPanel" Visibility="Collapsed" Margin="18,0,18,12">
    <Grid Margin="0,0,0,8"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><DatePicker x:Name="DateBox" SelectedDateChanged="DateChanged" Width="138" HorizontalAlignment="Left"/><Button Grid.Column="1" Content="导出报告" Click="ExportClick" Foreground="#007AFF"/></Grid>
    <DataGrid x:Name="HourGrid" Height="216" IsReadOnly="True" AutoGenerateColumns="False" CanUserAddRows="False" HeadersVisibility="Column" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#EEEEF2" BorderThickness="0" RowHeight="26" FontSize="11" Background="White" AlternatingRowBackground="#FAFAFC">
     <DataGrid.Columns><DataGridTextColumn Header="北京时间" Binding="{Binding Hour}" Width="*"/><DataGridTextColumn Header="样本" Binding="{Binding Samples}" Width="45"/><DataGridTextColumn Header="中位数" Binding="{Binding Median, StringFormat=F1, TargetNullValue=—}" Width="59"/><DataGridTextColumn Header="加权 TPS" Binding="{Binding Weighted, StringFormat=F1, TargetNullValue=—}" Width="66"/></DataGrid.Columns>
    </DataGrid><TextBlock Text="无样本显示 —；按首个输出项小时分组" Style="{StaticResource Muted}" Margin="0,6,0,0"/>
   </StackPanel>
   <StackPanel x:Name="SettingsPanel" Visibility="Collapsed" Margin="18,0,18,12"><TextBlock Text="Codex 数据目录" Style="{StaticResource Muted}" Margin="0,0,0,5"/><DockPanel><Button DockPanel.Dock="Right" Content="选择" Click="ChooseHomeClick" Foreground="#007AFF"/><TextBox x:Name="HomeBox" IsReadOnly="True" VerticalContentAlignment="Center" FontSize="10"/></DockPanel><CheckBox x:Name="TopmostBox" Content="始终置顶" IsChecked="True" Margin="0,10,0,0" Click="TopmostClick"/><TextBlock Text="只读本机日志，数据不发送到网络。" Style="{StaticResource Muted}" Margin="0,10,0,0"/></StackPanel>
   <Border Height="1" Background="#E7E7EB"/>
   <Grid Margin="18,12,14,14"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="自动刷新" VerticalAlignment="Center" Margin="0,0,9,0"/><ComboBox x:Name="CadenceBox" Grid.Column="1" Width="63" SelectionChanged="CadenceChanged"><ComboBoxItem Content="5 秒" Tag="5"/><ComboBoxItem Content="15 秒" Tag="15" IsSelected="True"/><ComboBoxItem Content="30 秒" Tag="30"/><ComboBoxItem Content="1 分钟" Tag="60"/></ComboBox><CheckBox x:Name="StartupBox" Grid.Column="2" Style="{StaticResource Switch}" Content="登录启动" VerticalAlignment="Center" HorizontalAlignment="Center" Click="StartupClick"/><Button Grid.Column="3" Content="⏻" FontSize="20" Click="ExitClick" ToolTip="退出" AutomationProperties.Name="退出" Padding="4,0"/></Grid>
  </StackPanel>
 </Border>
</Window>
